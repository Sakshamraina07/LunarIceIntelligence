{
  "name": "lunar-ice-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Repository-root task runner. The application lives in frontend/ (Vite + React) and backend/ (FastAPI). This file holds no dependencies of its own.",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "preview": "npm run preview --prefix frontend",
    "backend": "python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --app-dir backend --reload",
    "test": "python -m pytest -v backend/tests -o pythonpath=backend",
    "verify": "node frontend/scripts/verify_v8_view.mjs",
    "analysis": "python backend/scripts/build_analysis.py",
    "layers": "python backend/scripts/render_layers.py"
  }
}
