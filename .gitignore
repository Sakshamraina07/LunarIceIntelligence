# Deployment
.vercel/

# Environment variables
.env
.env*
.env*.local

# Common ignores
node_modules
.DS_Store
# Large raw data — not for GitHub (9GB Chandrayaan SAR)
# Large raw SAR dataset at repo root only (9GB) — NOT app source dirs like frontend/src/landing/data
/data/
.next/
.pytest_cache/
*.tif

# Python bytecode. These were TRACKED, and churned on every test run, so every
# diff carried dozens of binary .pyc changes and the real edits were buried.
__pycache__/
*.pyc
*.pyo
*.pyd

# Per-cell values from Chandrayaan-2 products (V23b): local only, rebuilt by backend/scripts/v21_extract.py
/docs/selected_cells_v21.json

# V24: native-resolution (25 m/px) renderings of DFSAR-derived quantities are not published; local only
/frontend/public/layers/cpr_heatmap.webp
/frontend/public/layers/dop_heatmap.webp

# AI coding-agent configuration and local working files (not part of the research record).
# Claude Code permission grants hold machine-specific paths; agent instructions are not repository documentation.
.claude/
CLAUDE.md
AGENTS.md
.cursor/
.aider*

# Manuscript working folder and submission-check output: the manuscript source is not tracked
# (see README "Reproducing", G32); paper/check_submission.py writes submission_check.json to the cwd.
/Claude outputs/
/submission_check.json

# Local Python environments
.venv/
venv/

# Local verification evidence that must not be published: gate-10 screenshots show the CPR/DOP proxy at map zoom
# (finer than 200 m/px), and gate_v28/tmp holds JSON/npz regenerated from the ISRO rasters.
/docs/gate10/
/docs/gate_v28/tmp/
# The V28 audit folder itself (scripts, logs, report) is not published yet; decision pending.
/docs/gate_v28/

# Screenshot outputs of frontend/scripts/{verify_v8_view,capture_layers,capture_traverse}.mjs. On the author's machine
# these capture every layer in layers.json, including the two local 25 m CPR/DOP files, so they must never be re-added.
/docs/v8_*.png
/docs/gate6/*.png
/docs/evidence/

# Coursework (an OOMD mini-project report naming other students); not part of the research record.
/UML Diagrams/
